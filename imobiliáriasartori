/* ---------- util: local ID generator (usa crypto se disponível) ---------- */
function genId() {
  try {
    if (typeof crypto !== "undefined" && crypto.randomUUID) return crypto.randomUUID();
  } catch (e) {}
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

/* ---------- useLocalStorage hook simples e seguro ---------- */
function useLocalStorage(key, initialValue) {
  const [state, setState] = useState(() => {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : typeof initialValue === "function" ? initialValue() : initialValue;
    } catch (e) {
      console.warn("useLocalStorage read failed:", e);
      return typeof initialValue === "function" ? initialValue() : initialValue;
    }
  });

  const setLocal = useCallback(
    (value) => {
      try {
        const next = typeof value === "function" ? value(state) : value;
        setState(next);
        localStorage.setItem(key, JSON.stringify(next));
      } catch (e) {
        console.warn("useLocalStorage write failed:", e);
      }
    },
    [key, state]
  );

  return [state, setLocal];
}

