<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Imobiliária</title>
  <style>
    body { font-family: sans-serif; margin:0; background:#dbe9df; color:#0f1a14; }
    header { background:#3b6b4a; color:white; padding:1rem; display:flex; align-items:center; }
    main { padding:1rem; max-width:1200px; margin:auto; }
    .listing-card { border:1px solid #ccc; background:white; padding:1rem; border-radius:0.5rem; margin-bottom:1rem; }
    .listing-card h3 { margin:0; font-weight:bold; }
    .listing-card .price { color:gray; font-size:0.9rem; }
    .listing-card .city { font-size:0.85rem; margin-top:0.3rem; }
    .listing-card p { font-size:0.85rem; margin-top:0.5rem; }
    footer { text-align:center; padding:1rem; color:#555; }
  </style>
</head>
<body>
  <header>
    <div>Imobiliária - Catálogo simples</div>
  </header>

  <main>
    <div class="listing-card">
      <h3>Apartamento ensolarado perto do parque</h3>
      <div class="price">R$ 420.000</div>
      <div class="city">São Paulo</div>
      <p>2 quartos, 1 banheiro, cozinha americana. Boa ventilação.</p>
    </div>

    <div class="listing-card">
      <h3>Casa de esquina com quintal</h3>
      <div class="price">R$ 650.000</div>
      <div class="city">Campinas</div>
      <p>3 quartos, amplo quintal e garagem para 2 carros.</p>
    </div>

    <div class="listing-card">
      <h3>Studio moderno no centro</h3>
      <div class="price">R$ 280.000</div>
      <div class="city">São Paulo</div>
      <p>Pronto para morar, perto de transporte e comércio.</p>
    </div>
  </main>

  <footer>© Imobiliária - Exemplo</footer>
</body>
</html>
